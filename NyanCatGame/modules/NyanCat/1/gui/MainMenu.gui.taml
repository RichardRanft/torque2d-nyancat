<GuiControl
    Name="MainMenu"
    isContainer="1"
    Profile="GuiDefaultProfile"
    HorizSizing="relative"
    VertSizing="relative"
    Position="0 0"
    Extent="1024 768"
    MinExtent="8 2"
    canSave="1"
    Visible="1"
    Active="0"
    hovertime="1000">
    <GuiSpriteCtrl
        Name="mainMenuBackground"
        canSaveDynamicFields="0"
        isContainer="0"
        Profile="GuiDefaultProfile"
        HorizSizing="relative"
        VertSizing="relative"
        Position="0 0"
        Extent="1024 768"
        MinExtent="8 2"
        canSave="1"
        Visible="1"
        Active="1"
        hovertime="1000"
        Image="@asset=NyanCatAssets:nyanBackground" />
    <GuiImageButtonCtrl
        Name="menuNewButton"
        canSaveDynamicFields="0"
        isContainer="0"
        Profile="GuiDefaultProfile"
        HorizSizing="relative"
        VertSizing="relative"
        Position="100 65"
        Extent="98 56"
        MinExtent="8 2"
        canSave="1"
        Visible="1"
        Active="1"
        hovertime="1000"
        groupNum="-1"
        buttonType="PushButton"
        useMouseEvents="0"
        NormalImage="@asset=NyanCatAssets:nyanButton1NewNorm"
        HoverImage="@asset=NyanCatAssets:nyanButton1NewNorm"
        DownImage="@asset=NyanCatAssets:nyanButton1NewNorm"
		InactiveImage="@asset=NyanCatAssets:nyanButton1NewNorm" />
    <GuiImageButtonCtrl
        Name="menuExitButton"
        canSaveDynamicFields="0"
        isContainer="0"
        Profile="GuiDefaultProfile"
        HorizSizing="relative"
        VertSizing="relative"
        Position="668 596"
        Extent="98 56"
        MinExtent="8 2"
        canSave="1"
        Visible="1"
        Active="1"
        hovertime="1000"
        groupNum="-1"
        buttonType="PushButton"
        useMouseEvents="0"
        NormalImage="@asset=NyanCatAssets:nyanButton1QuitNorm"
        HoverImage="@asset=NyanCatAssets:nyanButton1QuitNorm"
        DownImage="@asset=NyanCatAssets:nyanButton1QuitNorm"
		InactiveImage="@asset=NyanCatAssets:nyanButton1QuitNorm" />
</GuiControl>
