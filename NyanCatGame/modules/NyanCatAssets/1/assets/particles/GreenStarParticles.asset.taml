<ParticleAsset
    AssetName="GreenStarParticles">
    <ParticleAssetEmitter
		OrientationType="RANDOM"
        Animation="@asset=NyanCatAssets:StarGreenAnimation01">
        <ParticleAssetEmitter.Fields>
			<Quantity>
				<Key Time="0" Value="20.0"/>
			</Quantity>
            <SizeX>
				<Key Time="0" Value="0.25"/>
            </SizeX>
            <AlphaChannel>
				<Key Time="0" Value="1.0"/>
			</AlphaChannel>
            <Lifetime>
				<Key Time="0" Value="1.0"/>
            </Lifetime>						
        </ParticleAssetEmitter.Fields>
    </ParticleAssetEmitter>
</ParticleAsset>
